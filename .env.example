# The deterministic demo does not need an API key.
OPENAI_API_KEY=
LIVEGUARD_LLM_MODE=deterministic
LIVEGUARD_MODEL=gpt-5.6-luna

# Local control plane and browser.
LIVEGUARD_ADDR=127.0.0.1:8080
LIVEGUARD_HEADLESS=true
LIVEGUARD_ALLOWED_HOSTS=douyin.com,www.douyin.com,localhost,127.0.0.1
# LIVEGUARD_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Durable execution path.
LIVEGUARD_INFRA_MODE=durable
LIVEGUARD_DATABASE_URL=postgres://liveguard:liveguard_local@127.0.0.1:5433/liveguard?sslmode=disable
LIVEGUARD_REDIS_ADDR=127.0.0.1:6380
LIVEGUARD_SANDBOX_RPC_ADDR=127.0.0.1:9090
LIVEGUARD_SANDBOX_RPC_TARGET=127.0.0.1:9090
LIVEGUARD_SANDBOX_IMAGE=golang:1.26
LIVEGUARD_OTEL_ENDPOINT=127.0.0.1:4317

# Model-backed monitoring is opt-in; the MVP launcher can reuse local MiniMax settings.
LIVEGUARD_MONITOR_LLM_MODE=deterministic
LIVEGUARD_MONITOR_MODEL=MiniMax-M3
# run-mvp.ps1 can reuse the minimax-cn provider in ~/.openclaw/openclaw.json.
# Set this explicitly to choose a provider; supported values: minimax, openai, deepseek.
# LIVEGUARD_MONITOR_PROVIDER=minimax
# Explicit capability declaration for a custom model; not a connectivity test.
# LIVEGUARD_MONITOR_SUPPORTS_VISION=false
# LIVEGUARD_MONITOR_ENDPOINT=https://api.minimaxi.com/anthropic/v1/messages
# Global safety floor for LLM reviews; the per-goal plan may choose a slower cadence.
LIVEGUARD_MONITOR_REVIEW_INTERVAL=15s
LIVEGUARD_ASR_MODE=auto
LIVEGUARD_ASR_MODEL=asr-1.0
LIVEGUARD_ASR_LANGUAGE=zh
# LIVEGUARD_ASR_ENDPOINT=https://api.minimaxi.com/v1/speech_to_text
# LIVEGUARD_FFMPEG_BIN=D:\ffmpeg\bin\ffmpeg.exe

# Local control plane and browser.
LIVEGUARD_ADDR=127.0.0.1:8080
LIVEGUARD_ALLOWED_HOSTS=douyin.com,www.douyin.com,localhost,127.0.0.1
# LIVEGUARD_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional local OCR. Install Tesseract separately, then set the executable path.
# LIVEGUARD_TESSERACT_BIN=C:\Program Files\Tesseract-OCR\tesseract.exe
# Install chi_sim language data in Tesseract, then use Chinese + English.
# LIVEGUARD_OCR_LANGUAGE=chi_sim+eng
# Live frame capture cadence and first-page warmup for the dedicated Chrome.
# LIVEGUARD_LIVE_CAPTURE_INTERVAL=12s
# LIVEGUARD_LIVE_CAPTURE_WARMUP=7s

# Optional external PostgreSQL-backed monitor history. The default launcher saves to runtime/liveguard.json.
# LIVEGUARD_INFRA_MODE=durable
# LIVEGUARD_DATABASE_URL=postgres://user:password@localhost:5432/liveguard?sslmode=disable
# LIVEGUARD_LOCAL_STATE_PATH=runtime/liveguard.json
# Optional OTLP trace export to an externally managed collector. Disabled by default.
# LIVEGUARD_OTEL_ENDPOINT=localhost:4317
